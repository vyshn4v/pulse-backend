# Postgres connection components
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=pulse_v3

# Redis connection components
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=PULSE

# Optional full URLs & Connection Pool Config (Tuned for 1GB RAM / 1 vCPU)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pulse_v3?connection_limit=2&pool_timeout=10
DB_CONNECTION_LIMIT=2
DB_POOL_TIMEOUT=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_MAX_MEMORY=30mb
REDIS_CLIENT_TIMEOUT=300

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
ALLOW_LIST_EMAIL=your_email@example.com

# Email Alert Dispatcher (for token expiry and failed posts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PULSE OS" <your_email@gmail.com>

# LinkedIn Auto-Publisher (Option 1: Direct Access Token)
LINKEDIN_ACCESS_TOKEN=your_oauth2_access_token_here
LINKEDIN_MEMBER_URN=urn:li:person:YOUR_MEMBER_ID
LINKEDIN_ACCOUNT_NAME=Your Name

# LinkedIn Auto-Publisher (Option 2: OAuth 2.0 Web Connect)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/callback

# Unified LLM Provider (Multi-Agent Brain Specialists, Gemini Master Oracle & Conversational AI)
OPENROUTER_API_KEY=your_openrouter_api_key   # Universal key (Accesses Gemini 2.0 Flash, Gemini Pro 1.5, Llama 3.3 70B, etc.)
OPENROUTER_SPECIALIST_MODEL=google/gemini-2.0-flash-001 # (Optional: defaults to google/gemini-2.0-flash-001)
OPENROUTER_ORACLE_MODEL=google/gemini-2.0-flash-001     # (Optional: defaults to google/gemini-2.0-flash-001 or google/gemini-pro-1.5)

# Pinecone Vector DB (for Phase 6/7/8)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=pulse-v3

# Server & App Config
PORT=5000
JWT_SECRET=your_jwt_secret_key
FRONTEND_URL=http://localhost:5173

# Telemetry Daemon & Remote Monitors (PC & Android)
PULSE_API_KEY=your_secret_telemetry_api_key_here
